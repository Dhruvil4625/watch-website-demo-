# ==============================================================================
# GUJARAT TIME COMPANY (GTC) · ENVIRONMENT CONFIGURATION SPECIFICATION
# RULE 1: Never expose private secrets in frontend code.
# Only variables prefixed with VITE_ are bundled into client-side code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE ENVIRONMENT VARIABLES (Vite Frontend — Safe for Browser)
# Note: These values are intentionally exposed to the browser client.
# Never place secret keys (e.g. service role keys, SMTP passwords) here!
# ------------------------------------------------------------------------------

# Supabase Project URL & Anon/Public API Key
# (The anon key is restricted by Supabase Row-Level Security policies)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Razorpay Client-Side Key ID (Public Checkout Key only)
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key_id_here

# --- ADMIN IDENTIFIER ---
VITE_ADMIN_EMAIL=your_admin_email@gmail.com

# ==========================================================
# RESERVED FOR LATER (When you add Backend / Edge Functions)
# Do NOT add the VITE_ prefix to secret keys!
# ==========================================================
# SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key
# RAZORPAY_KEY_SECRET=your_secret_razorpay_key
# RESEND_API_KEY=re_your_resend_secret_key
